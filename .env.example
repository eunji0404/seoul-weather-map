# 이 파일을 복사해 .env 파일을 만들고 본인의 키를 입력하세요.
# (.env 파일은 인증키가 들어있으므로 절대 Git에 올리지 않습니다.)

# 기상청 API허브 인증키
KMA_AUTH_KEY=

# 동네예보 격자자료 API 주소 (필요시 변경)
KMA_GRID_URL=https://apihub.kma.go.kr/api/typ01/cgi-bin/url/nph-dfs_shrt_grd

# 키가 없거나 호출이 실패할 때 가짜(mock) 데이터로 화면을 띄울지 여부 (기본 true)
USE_MOCK_ON_FAILURE=true

PORT=3001
